---
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import Base from '../layouts/Base.astro';
import FieldList from '../components/FieldList.astro';
import { loadAcervo } from '../lib/acervo.mjs';

const { fields } = await loadAcervo();
---
<Base title="Acervo LICHTARA" description="Biblioteca digital do Sistema LICHTARA. Explore os campos ou pesquise nos capítulos." tone="dark">
  <section class="hero" aria-labelledby="welcome-title">
    <div class="container hero-inner">
      <div class="intro">
        <h1 id="welcome-title">O que deseja<br /> <em>explorar?</em></h1>
        <p>Explore os campos do Sistema LICHTARA ou pesquise nos textos originais do acervo.</p>
        <form class="entry-search" action="/busca/" method="get" role="search">
          <label class="visually-hidden" for="entry-q">Pesquisar nos capítulos</label>
          <input id="entry-q" name="q" type="search" placeholder="Pesquisar no acervo" required />
          <button type="submit">Buscar <span aria-hidden="true">↗</span></button>
        </form>
        <a class="explore" href="#campos">Explorar os campos <span aria-hidden="true">↓</span></a>
      </div>
      <div class="figure" aria-hidden="true">
        <div class="figure-axis"></div>
        <img src="/identidade/geometria.svg" alt="" width="360" height="360" fetchpriority="high" />
      </div>
    </div>
  </section>
  <section id="campos" class="field-section" aria-labelledby="fields-title">
    <div class="container fields-inner">
      <div class="collection-intro">
        <h2 id="fields-title">Campos do acervo</h2>
        <p>Escolha um campo para descobrir seus manuais e capítulos.</p>
      </div>
      <FieldList fields={fields} />
    </div>
  </section>
</Base>

<style>
  .hero {
    --focus: #f3e5c9;
    background:
      radial-gradient(ellipse at 74% 48%, #133053 0%, #0a182b 32%, #050a15 68%),
      #050a15;
    color: #f3e5c9;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1rem, 4vw, 4.5rem);
    padding-block: clamp(3.65rem, 4.7vw, 4.75rem);
  }

  .intro {
    position: relative;
    z-index: 1;
  }

  .intro h1 {
    color: #f7f3e9;
    font-family: var(--font-editorial);
    font-weight: 500;
    font-size: clamp(4rem, 7.1vw, 7.2rem);
    letter-spacing: -.055em;
    line-height: .82;
    margin: 0 0 1.5rem;
  }

  .intro h1 em {
    color: #d8b97a;
    font-weight: inherit;
  }

  .intro p {
    color: #c3ccdd;
    font-size: clamp(.94rem, 1.7vw, 1.05rem);
    line-height: 1.7;
    max-width: 33ch;
    margin: 0 0 1.85rem;
  }

  .entry-search {
    display: flex;
    align-items: stretch;
    width: min(100%, 29rem);
    min-height: 3.25rem;
    border: 1px solid #8591a07a;
    border-radius: .45rem;
    background: #101d31;
  }

  .entry-search input {
    flex: 1;
    width: 0;
    min-width: 0;
    border: 0;
    border-radius: .4rem 0 0 .4rem;
    padding: .65rem .92rem;
    color: white;
    background: transparent;
    font: inherit;
  }

  .entry-search input::placeholder {
    color: #bec8d9;
    opacity: 1;
  }

  .entry-search button {
    color: #0b1e38;
    background: #e1c68e;
    border: 0;
    border-radius: 0 .34rem .34rem 0;
    padding: 0 clamp(.55rem, 2vw, 1rem);
    font: inherit;
    font-weight: 750;
    cursor: pointer;
  }

  .entry-search button:hover {
    background: #f3e5c9;
  }

  .entry-search button span {
    margin-left: .2rem;
  }

  .explore {
    display: inline-flex;
    gap: .65rem;
    align-items: center;
    min-height: 2.75rem;
    margin-top: .33rem;
    color: #f3e5c9;
    font-size: .9rem;
    text-decoration-color: #d8b97a95;
    text-underline-offset: .28em;
  }

  .figure {
    display: grid;
    place-items: center;
    position: relative;
    width: min(100%, 22rem);
    aspect-ratio: 1;
    justify-self: end;
    pointer-events: none;
  }

  .figure img {
    display: block;
    position: relative;
    width: 85%;
    height: auto;
    filter: drop-shadow(0 0 1rem #d8b97a50);
  }

  .figure-axis {
    position: absolute;
    inset: 3%;
    border: 1px solid #d8b97a31;
    border-radius: 50%;
    box-shadow: 0 0 0 1.15rem #d8b97a07, inset 0 0 3.4rem #050a15a0;
  }

  .figure-axis::before, .figure-axis::after {
    content: "";
    position: absolute;
    background: linear-gradient(90deg, transparent, #d8b97a3b 25% 75%, transparent);
    inset: 50% -11% auto;
    height: 1px;
  }

  .figure-axis::after {
    rotate: 90deg;
  }

  .field-section {
    background: #f7f3e9;
    color: #0b1e38;
    border-top: 1px solid #d8b97a7d;
    padding-block: clamp(3rem, 6vw, 5.25rem);
    scroll-margin-top: 1rem;
  }

  .fields-inner {
    display: grid;
    grid-template-columns: minmax(0, .95fr) minmax(0, 1.65fr);
    gap: clamp(1.5rem, 4.75vw, 5rem);
  }

  .collection-intro h2 {
    font-family: var(--font-editorial);
    font-weight: 500;
    font-size: clamp(2.5rem, 4.2vw, 4rem);
    line-height: .98;
    margin: 0 0 .85rem;
  }

  .collection-intro p {
    max-width: 30ch;
    color: #505b6b;
    margin: 0;
  }

  @media (max-width: 44rem) {
    .hero-inner, .fields-inner {
      grid-template-columns: 1fr;
    }

    .hero-inner {
      position: relative;
      overflow: hidden;
    }

    .figure {
      position: absolute;
      top: 4%;
      right: -5rem;
      width: min(66vw, 19rem);
      opacity: .26;
    }
  }
</style>
